# Set these in the Python cuesync server's environment (Next.js does not forward them).
# Comfy API v2 endpoint, for example self-hosted comfy-api-proxy via SSH tunnel:
COMFY_BASE_URL=http://127.0.0.1:8189
# Comfy Cloud / managed deployment / protected local proxy credentials:
COMFY_API_KEY=
# Native ComfyUI inventory for node/model preflight. Standard local 8189 -> 8188 is automatic.
# Cloud uses its documented /api/object_info; custom v2 deployments need an explicitly exposed native inventory.
COMFYUI_BASE_URL=
# Optional separate native-endpoint bearer token; the proxy token is never forwarded to another origin.
COMFYUI_API_KEY=
